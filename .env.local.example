# Google Fonts
GOOGLE_FONTS_API_KEY=

# Instagram Graph API
# IG_ACCESS_TOKEN: Long-lived (60-day) Facebook User Access Token.
#   Get it from: https://developers.facebook.com/tools/explorer/
#   Make sure to include these permissions: instagram_basic, instagram_content_publish,
#   pages_read_engagement, pages_show_list
IG_ACCESS_TOKEN=
IG_USER_ID=
# Required for automatic token refresh (lib/token.ts keeps the token alive forever).
# Find these in your Meta App Dashboard > App Settings > Basic.
FB_APP_ID=
FB_APP_SECRET=

# Vercel Storage
BLOB_READ_WRITE_TOKEN=
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
# Optional aliases if your Vercel integration injects Upstash-style names
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_READ_ONLY_TOKEN=

# Pipeline security
CRON_SECRET=

# Branding
NEXT_PUBLIC_BRAND_HANDLE=
